# =============================================================================
# LendLoop configuration. Copy to the files named in each section; never commit
# real values. Generate secrets with:  openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Next.js app  ->  .env.local
# -----------------------------------------------------------------------------
# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Convex client URL (printed by `npx convex dev`; safe to expose to the browser)
NEXT_PUBLIC_CONVEX_URL=
# Written automatically by `npx convex dev` (used by the Convex CLI only)
CONVEX_DEPLOYMENT=

# -----------------------------------------------------------------------------
# 2) Convex deployment environment  ->  Convex dashboard > Settings > Environment
#    Variables, or: npx convex env set NAME value
#    These are server-side only and never reach the browser.
# -----------------------------------------------------------------------------
# Clerk "Frontend API URL" (e.g. https://verb-noun-00.clerk.accounts.dev). Convex
# uses it to verify Clerk JWTs (see convex/auth.config.ts).
CLERK_JWT_ISSUER_DOMAIN=
# Where n8n's webhook lives. Local: http://localhost:5678/webhook/lendloop/request-events
# (Convex *cloud* cannot reach localhost: use a tunnel URL, see README). Production: https only.
N8N_WEBHOOK_URL=
# HMAC key for Convex -> n8n webhooks. MUST equal the same variable in section 3.
CONVEX_N8N_WEBHOOK_SECRET=
# Bearer secret n8n presents to Convex HTTP endpoints. MUST equal section 3. Different from the HMAC key.
N8N_CONVEX_API_SECRET=
# OPTIONAL hardening: a second key (>= 32 chars, different from the two above). When set in Convex,
# every n8n -> Convex call must also carry an HMAC over its route and body. Set the same value in section 3.
N8N_CONVEX_SIGNING_SECRET=
# Public URL of the Next.js app, used for links inside notification emails.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3) Docker Compose / n8n  ->  .env (read by `docker compose`)
# -----------------------------------------------------------------------------
# Encrypts credentials stored in n8n's database. Set once, back it up, never change it.
N8N_ENCRYPTION_KEY=
# Convex HTTP actions origin: https://<deployment-name>.convex.site
CONVEX_SITE_URL=
# Same values as in section 2 (n8n needs them to verify and call Convex).
CONVEX_N8N_WEBHOOK_SECRET=
N8N_CONVEX_API_SECRET=
# Optional: only if you also set it in Convex (see section 2). Unset = bearer-only calls.
N8N_CONVEX_SIGNING_SECRET=
# Optional
GENERIC_TIMEZONE=UTC
LENDLOOP_FROM_EMAIL=LendLoop <no-reply@lendloop.local>
N8N_PUBLIC_URL=http://localhost:5678/
