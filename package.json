{
  "name": "lendloop",
  "version": "1.0.0",
  "private": true,
  "description": "LendLoop - neighborhood tool lending with Clerk, Convex and n8n",
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "n8n:build": "node scripts/build-n8n-workflows.mjs",
    "n8n:up": "docker compose up -d",
    "n8n:down": "docker compose down",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.54",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.67",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
